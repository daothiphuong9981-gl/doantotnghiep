# Sao chép file này thành .env.local và điền giá trị. Không đưa .env.local lên Git.
# Lấy ở Supabase: Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://<ma-du-an>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=<khoa-anon-hoac-publishable>

# Trợ lý AI (chỉ dùng ở máy chủ). Lấy khóa ở Google AI Studio. Thiếu khóa thì trợ lý tự chuyển sang bộ lọc thường.
GEMINI_API_KEY=
# GEMINI_MODEL=gemini-3.5-flash-lite
# AI_DAILY_LIMIT=20
# AI_DEBUG=1

# Tùy chọn: khóa bí mật cho /api/cron/expire-holds (chỉ cần khi dùng Vercel Cron thay cho pg_cron)
# CRON_SECRET=<chuoi-ngau-nhien-dai>

# Email xác nhận đặt sân (chỉ dùng ở máy chủ). Gửi từ MỘT hộp Gmail hệ thống; tên người gửi là tên sân,
# trả lời thư tới email chủ sân. Thiếu các biến này thì hệ thống vẫn chạy, chỉ không gửi email.
# SMTP_PASS là Mật khẩu ứng dụng 16 ký tự (Google Account > Bảo mật > Xác minh 2 bước > Mật khẩu ứng dụng).
# SMTP_USER=ten-hop-thu@gmail.com
# SMTP_PASS=<mat-khau-ung-dung>
# Khóa service_role (Supabase > Project Settings > API Keys), để máy chủ đọc hàng đợi email. KHÔNG thêm NEXT_PUBLIC_.
# SUPABASE_SERVICE_ROLE_KEY=<khoa-service-role>
# Địa chỉ trang web trong link của thư (trên Vercel tự lấy tên miền production nếu bỏ trống)
# APP_URL=https://caulongdanang.vercel.app
# CRON_SECRET ở trên cũng bảo vệ /api/cron/send-emails (Vercel Cron gửi lại thư lỗi mỗi ngày lúc 8:00)
